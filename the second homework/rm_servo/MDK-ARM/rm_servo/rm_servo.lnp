"rm_servo\stm32f1xx_hal_tim_ex.o"
"rm_servo\system_stm32f1xx.o"
--strict --scatter "rm_servo\rm_servo.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "rm_servo.map" -o rm_servo\rm_servo.axf